@page
@model SGECAR.App.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
    var puedeAgregar = Model.Puede(Acciones.Agregar);
    var puedeModificar = Model.Puede(Acciones.Modificar);
    var puedeEliminar = Model.Puede(Acciones.Eliminar);
}

<div class="encabezado">
    <div>
        <h1>Clientes</h1>
        <p>Mantenimiento de clientes de la empresa.</p>
    </div>
    @* Si el rol no tiene el permiso, el botón se ve con candado y el servidor muestra "Permisos insuficientes" *@
    <a asp-page="Crear" class="btn btn-primario @(puedeAgregar ? "" : "btn-bloqueado")" title="@(puedeAgregar ? "" : "Su rol no puede agregar")">
        @Iconos.Svg(puedeAgregar ? "plus" : "lock") Nuevo cliente
    </a>
</div>

<div class="indicadores">
    <div class="indicador"><span>Total</span><strong>@Model.Total</strong></div>
    <div class="indicador"><span>Con teléfono</span><strong>@Model.ConTelefono</strong></div>
    <div class="indicador"><span>Sin teléfono</span><strong>@Model.SinTelefono</strong></div>
    <div class="indicador"><span>Mostrando</span><strong>@Model.Clientes.Count</strong></div>
</div>

<div class="panel">
    <form method="get" class="panel-filtros">
        <input type="number" name="id" value="@Model.Id" class="entrada filtro-id" placeholder="ID" min="1" />
        <div class="entrada-grupo flex-grow-1">
            @Iconos.Svg("search")
            <input type="search" name="buscar" value="@Model.Buscar" class="entrada" placeholder="Buscar por nombre, apellido o correo..." maxlength="100" />
        </div>
        <select name="ubicacion" class="entrada selector" asp-items="Model.OpcionesUbicacion" onchange="this.form.submit()">
            <option value="">Cualquier dirección</option>
        </select>
        <select name="contacto" class="entrada selector" onchange="this.form.submit()">
            <option value="">Con y sin teléfono</option>
            <option value="con-telefono" selected="@(Model.Contacto == "con-telefono")">Con teléfono</option>
            <option value="sin-telefono" selected="@(Model.Contacto == "sin-telefono")">Sin teléfono</option>
        </select>
        <button type="submit" class="btn btn-secundario">Buscar</button>
        @if (Model.HayFiltros)
        {
            <a asp-page="Index" class="btn btn-secundario">Limpiar</a>
        }
    </form>

    <div class="table-responsive">
        <table class="tabla">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Dirección</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Clientes.Count == 0)
                {
                    <tr><td colspan="6" class="tabla-vacia">No se encontraron clientes.</td></tr>
                }
                @foreach (var c in Model.Clientes)
                {
                    <tr>
                        <td class="texto-suave">@c.ClienteId</td>
                        <td>
                            <span class="av">@c.Nombre.Substring(0, 1).ToUpper()</span>
                            <strong>@c.Nombre @c.Apellido</strong>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(c.Telefono) ? "—" : c.Telefono)</td>
                        <td>@c.Correo</td>
                        <td>@(string.IsNullOrWhiteSpace(c.Direccion) ? "—" : c.Direccion)</td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Editar" asp-route-id="@c.ClienteId" class="btn-accion @(puedeModificar ? "" : "btn-bloqueado")">
                                @Iconos.Svg(puedeModificar ? "edit" : "lock") Modificar
                            </a>
                            @if (puedeEliminar)
                            {
                                <form method="post" asp-page-handler="Eliminar" asp-route-id="@c.ClienteId" class="d-inline"
                                      data-confirmar="¿Eliminar el cliente «@c.Nombre @c.Apellido»? Esta acción no se puede deshacer.">
                                    <button type="submit" class="btn-accion btn-accion-peligro">@Iconos.Svg("trash") Eliminar</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Eliminar" asp-route-id="@c.ClienteId" class="d-inline">
                                    <button type="submit" class="btn-accion btn-bloqueado">@Iconos.Svg("lock") Eliminar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="panel-pie">@Model.Clientes.Count registro(s)</div>
</div>

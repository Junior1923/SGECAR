@* Campos del producto: los comparten Crear y Editar *@
@model SGECAR.App.Pages.Productos.DatosProducto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var categorias = (List<SelectListItem>)ViewData["Categorias"]!;
}

<div class="row g-3">
    <div class="col-md-4 campo">
        <label asp-for="Codigo"></label>
        <input asp-for="Codigo" class="entrada texto-mayuscula" maxlength="50" placeholder="PROD-004" autofocus />
        <small class="ayuda">Único. Se guarda en mayúsculas.</small>
        <span asp-validation-for="Codigo" class="error-campo"></span>
    </div>
    <div class="col-md-8 campo">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="entrada" maxlength="150" />
        <span asp-validation-for="Nombre" class="error-campo"></span>
    </div>
    <div class="col-md-4 campo">
        <label asp-for="Precio"></label>
        <input asp-for="Precio" class="entrada" inputmode="decimal" maxlength="16" placeholder="0.00" />
        <span asp-validation-for="Precio" class="error-campo"></span>
    </div>
    <div class="col-md-4 campo">
        <label asp-for="Stock"></label>
        <input asp-for="Stock" type="number" class="entrada" min="0" step="1" placeholder="0" />
        <span asp-validation-for="Stock" class="error-campo"></span>
    </div>
    <div class="col-md-4 campo">
        <label asp-for="CategoriaId"></label>
        <select asp-for="CategoriaId" asp-items="categorias" class="entrada selector">
            <option value="">Seleccione una categoría</option>
        </select>
        <span asp-validation-for="CategoriaId" class="error-campo"></span>
    </div>
</div>
